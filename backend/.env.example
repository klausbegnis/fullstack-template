APP_NAME=Backend API
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
WORKERS=1

# Leave unset (or false) outside of automated tests; set to true only to let
# the application start without a DATABASE_URL, as the test suite does.
TESTING=false

DATABASE_URL=postgresql+asyncpg://backend:backend@localhost:5432/backend
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

CORS_ORIGINS=["http://localhost:3000"]

# REQUIRED: must be at least 32 bytes long and MUST be replaced with a unique,
# random secret before deploying anywhere outside local development, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_JWT_ISSUER=backend-api
AUTH_JWT_AUDIENCE=backend-web
AUTH_ACCESS_TTL_SECONDS=900
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=false
AUTH_ACCESS_COOKIE=app_access
AUTH_REFRESH_COOKIE=app_refresh
AUTH_CSRF_COOKIE=app_csrf
