APP_NAME=Backend API
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
WORKERS=1

# Leave unset (or false) outside of automated tests; set to true only to let
# the application start without a DATABASE_URL, as the test suite does.
TESTING=false

DATABASE_URL=postgresql+asyncpg://backend:backend@localhost:5432/backend
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

CORS_ORIGINS=["http://localhost:3000"]

# REQUIRED: must be at least 32 bytes long and MUST be replaced with a unique,
# random secret before deploying anywhere outside local development, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_JWT_ISSUER=backend-api
AUTH_JWT_AUDIENCE=backend-web
AUTH_ACCESS_TTL_SECONDS=900
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=false
AUTH_ACCESS_COOKIE=app_access
AUTH_REFRESH_COOKIE=app_refresh
AUTH_CSRF_COOKIE=app_csrf

# Login throttling, counted in iam.rate_limit_windows and shared by every worker.
# Attempts per window, per normalized email and per client IP.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_EMAIL=10
RATE_LIMIT_LOGIN_PER_IP=50
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
# Trust X-Forwarded-For (right-most hop) only behind a proxy that sets it.
RATE_LIMIT_TRUST_FORWARDED=false
# Header an edge proxy overwrites with the client address (e.g. X-Real-IP);
# leave empty unless every request passes through that proxy.
RATE_LIMIT_CLIENT_IP_HEADER=

# Unhandled-error alerts, reported only under ENVIRONMENT=production. Empty
# ERROR_ALERT_WEBHOOK_URL logs them; set it to a webhook (a Slack incoming
# webhook works as is) to receive JSON {"text": ...} posts instead.
ERROR_ALERT_WEBHOOK_URL=
# Repeats of one error inside the window become one summary when it closes;
# deliveries past the hourly cap are dropped and counted in one notice.
ERROR_ALERT_REPEAT_WINDOW_SECONDS=600
ERROR_ALERT_MAX_POSTS_PER_HOUR=20
