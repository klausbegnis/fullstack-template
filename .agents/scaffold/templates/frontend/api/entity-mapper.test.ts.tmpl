import { describe, expect, it } from "vitest";
import { to{{Entity}}, to{{Entities}}Page } from "@/features/{{feature}}/api/{{entity-file}}-mapper";
import { build{{Entity}}Dto } from "@/features/{{feature}}/testing/factories";

describe("to{{Entity}}", () => {
  it("maps every field and parses the timestamps", () => {
    const dto = build{{Entity}}Dto({
      id: "a1",
      created_at: "2026-01-01T00:00:00Z",
      updated_at: "2026-01-02T00:00:00Z",
    });

    const {{entity}} = to{{Entity}}(dto);

    expect({{entity}}.id).toBe("a1");
    expect({{entity}}.createdAt).toEqual(new Date("2026-01-01T00:00:00Z"));
    expect({{entity}}.updatedAt).toEqual(new Date("2026-01-02T00:00:00Z"));
{{mapper_test_assertions}}
  });
});

describe("to{{Entities}}Page", () => {
  it("unwraps the paginated envelope into the domain page shape", () => {
    const page = to{{Entities}}Page({
      success: true,
      data: [build{{Entity}}Dto({ id: "a1" })],
      total: 1,
      page: 1,
      page_size: 20,
      total_pages: 1,
    });

    expect(page.items).toHaveLength(1);
    expect(page.items[0]?.id).toBe("a1");
    expect(page.pageSize).toBe(20);
    expect(page.totalPages).toBe(1);
  });
});
