import { render, screen } from "@testing-library/react";
import userEvent from "@testing-library/user-event";
import { describe, expect, it, vi } from "vitest";
import { {{Entities}}ListView } from "@/features/{{feature}}/components/{{feature}}-list-view";
import { build{{Entity}} } from "@/features/{{feature}}/testing/factories";

const items = [build{{Entity}}({ id: "a1" }), build{{Entity}}({ id: "a2" })];

describe("{{Entities}}ListView", () => {
  it("renders one row per {{entity-words}}", () => {
    render(
      <{{Entities}}ListView
        {{feature-camel}}={items}
        status="ready"
        page={1}
        totalPages={2}
        canGoToPreviousPage={false}
        canGoToNextPage={true}
        onPreviousPage={vi.fn()}
        onNextPage={vi.fn()}
      />,
    );

    expect(screen.getAllByRole("row")).toHaveLength(items.length + 1);
    expect(screen.getByRole("columnheader", { name: "{{first_field_label}}" })).toBeInTheDocument();
  });

  it("shows a spinner while loading and no table", () => {
    render(
      <{{Entities}}ListView
        {{feature-camel}}={[]}
        status="loading"
        page={1}
        totalPages={1}
        canGoToPreviousPage={false}
        canGoToNextPage={false}
        onPreviousPage={vi.fn()}
        onNextPage={vi.fn()}
      />,
    );

    expect(screen.getByRole("status")).toBeInTheDocument();
    expect(screen.queryByRole("table")).not.toBeInTheDocument();
  });

  it("shows an error alert when loading failed", () => {
    render(
      <{{Entities}}ListView
        {{feature-camel}}={[]}
        status="error"
        page={1}
        totalPages={1}
        canGoToPreviousPage={false}
        canGoToNextPage={false}
        onPreviousPage={vi.fn()}
        onNextPage={vi.fn()}
      />,
    );

    expect(screen.getByRole("alert")).toHaveTextContent("Failed to load {{feature-words}}");
  });

  it("reports the next page the caller asked for", async () => {
    const user = userEvent.setup();
    const onNextPage = vi.fn();
    render(
      <{{Entities}}ListView
        {{feature-camel}}={items}
        status="ready"
        page={1}
        totalPages={2}
        canGoToPreviousPage={false}
        canGoToNextPage={true}
        onPreviousPage={vi.fn()}
        onNextPage={onNextPage}
      />,
    );

    await user.click(screen.getByRole("button", { name: "Next" }));

    expect(onNextPage).toHaveBeenCalledOnce();
  });

  it("disables the previous button on the first page", () => {
    render(
      <{{Entities}}ListView
        {{feature-camel}}={items}
        status="ready"
        page={1}
        totalPages={2}
        canGoToPreviousPage={false}
        canGoToNextPage={true}
        onPreviousPage={vi.fn()}
        onNextPage={vi.fn()}
      />,
    );

    expect(screen.getByRole("button", { name: "Previous" })).toBeDisabled();
  });
});
