from __future__ import annotations

import asyncio
from collections.abc import Iterator
import os
import uuid

from fastapi.testclient import TestClient
import pytest
from sqlalchemy.ext.asyncio import create_async_engine
from sqlalchemy.pool import NullPool

from app.config import Settings, get_settings
from app.core.database import create_session_factory, get_session
from app.core.security import hash_password
from app.main import app
from app.models.user import UserRole
from app.repositories.users import UserRepository

PASSWORD = "Correct horse battery staple 123!"
ORIGIN = "http://localhost:3000"


@pytest.fixture
def {{entities}}_client() -> Iterator[TestClient]:
    """Serve the app against the real database with a seeded admin and member."""
    engine = create_async_engine(os.environ["DATABASE_URL"], poolclass=NullPool)
    factory = create_session_factory(engine)
    admin_email = f"admin-{uuid.uuid4()}@example.test"
    member_email = f"member-{uuid.uuid4()}@example.test"

    async def seed() -> None:
        async with factory() as session:
            repository = UserRepository(session)
            await repository.create_bootstrap_user(
                email=admin_email,
                password_hash=hash_password(PASSWORD),
                role=UserRole.ADMIN,
            )
            await repository.create_bootstrap_user(
                email=member_email,
                password_hash=hash_password(PASSWORD),
                role=UserRole.MEMBER,
            )
            await session.commit()

    asyncio.run(seed())

    async def override_session():
        async with factory() as session:
            yield session

    app.dependency_overrides[get_session] = override_session
    app.dependency_overrides[get_settings] = lambda: Settings(
        DATABASE_URL=os.environ["DATABASE_URL"],
        TESTING=True,
        DEBUG=True,
        AUTH_COOKIE_SECURE=False,
    )
    with TestClient(app) as client:
        client.admin_email = admin_email
        client.member_email = member_email
        yield client
    app.dependency_overrides.clear()
    asyncio.run(engine.dispose())


def login(client: TestClient, email: str):
    """Open a cookie session for the given account."""
    return client.post(
        "/auth/login",
        json={"email": email, "password": PASSWORD},
        headers={"Origin": ORIGIN},
    )


def create_{{entity}}(client: TestClient, **overrides: object):
    """Post a valid create payload, letting a caller override single fields."""
    payload: dict[str, object] = {{create_payload_dict}}
    payload.update(overrides)
    return client.post("/{{entities}}", json=payload)


def test_unauthenticated_request_is_rejected({{entities}}_client: TestClient) -> None:
    response = {{entities}}_client.get("/{{entities}}")

    assert response.status_code == 401


def test_admin_can_create_get_list_and_update_a_{{entity}}(
    {{entities}}_client: TestClient,
) -> None:
    login({{entities}}_client, {{entities}}_client.admin_email)

    created = create_{{entity}}({{entities}}_client)
    assert created.status_code == 201
    body = created.json()
    assert body["success"] is True
    {{entity}}_id = body["data"]["id"]

    fetched = {{entities}}_client.get(f"/{{entities}}/{{{entity}}_id}")
    assert fetched.status_code == 200
    assert fetched.json()["data"]["id"] == {{entity}}_id

    listed = {{entities}}_client.get("/{{entities}}", params={"page": 1, "page_size": 20})
    assert listed.status_code == 200
    page = listed.json()
    assert page["page"] == 1
    assert page["total"] >= 1
    assert any(item["id"] == {{entity}}_id for item in page["data"])

    updated = {{entities}}_client.patch(
        f"/{{entities}}/{{{entity}}_id}", json={{update_payload_dict}}
    )
    assert updated.status_code == 200
    assert {{update_response_assertion}}


def test_get_unknown_{{entity}}_returns_404({{entities}}_client: TestClient) -> None:
    login({{entities}}_client, {{entities}}_client.admin_email)

    response = {{entities}}_client.get(f"/{{entities}}/{uuid.uuid4()}")

    assert response.status_code == 404
    assert response.json()["error"]["code"] == "not_found"


def test_member_cannot_create_a_{{entity}}({{entities}}_client: TestClient) -> None:
    member_client = TestClient(app)
    login(member_client, str({{entities}}_client.member_email))

    response = create_{{entity}}(member_client)

    assert response.status_code == 403
    assert response.json()["error"]["code"] == "forbidden"
