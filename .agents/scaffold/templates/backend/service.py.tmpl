from __future__ import annotations

import uuid

from sqlalchemy.exc import IntegrityError
from sqlalchemy.ext.asyncio import AsyncSession

from app.core.exceptions import ConflictException, NotFoundException
from app.core.transactions import transaction
from app.models.{{entity}} import {{Entity}}
from app.repositories.{{entities}} import {{Entity}}Repository
from app.schemas.api.{{entities}} import (
    {{Entity}}Create,
    {{Entity}}ListFilters,
    {{Entity}}Read,
    {{Entity}}Update,
)

CONFLICT_MESSAGE = "A {{entity}} with these values already exists"
NOT_FOUND_MESSAGE = "{{Entity}} not found"


def to_{{entity}}_read(record: {{Entity}}) -> {{Entity}}Read:
    """Map a persisted {{entity}} to its public API representation."""
    return {{Entity}}Read(
        id=record.id,
{{service_read_kwargs}}
        created_at=record.created_at,
        updated_at=record.updated_at,
    )


class {{Entity}}Service:
    """Coordinate {{entity}} use cases and their transaction boundaries."""

    def __init__(
        self, *, session: AsyncSession, {{entities}}: {{Entity}}Repository
    ) -> None:
        self._session = session
        self._{{entities}} = {{entities}}

    async def list_{{entities}}(
        self, filters: {{Entity}}ListFilters
    ) -> tuple[list[{{Entity}}Read], int]:
        """Return one page of {{entities}} together with the total row count."""
        records, total = await self._{{entities}}.list(
            offset=filters.offset, limit=filters.page_size
        )
        return [to_{{entity}}_read(record) for record in records], total

    async def get_{{entity}}(self, {{entity}}_id: uuid.UUID) -> {{Entity}}Read:
        """Return one {{entity}}, or raise when no row carries that identifier."""
        record = await self._{{entities}}.get({{entity}}_id)
        if record is None:
            raise NotFoundException(NOT_FOUND_MESSAGE)
        return to_{{entity}}_read(record)

    async def create_{{entity}}(self, payload: {{Entity}}Create) -> {{Entity}}Read:
        """Create one {{entity}} inside a single transaction boundary."""
        try:
            async with transaction(self._session):
                record = await self._{{entities}}.create(
{{service_create_kwargs}}
                )
        except IntegrityError:
            raise ConflictException(CONFLICT_MESSAGE) from None
        return to_{{entity}}_read(record)

    async def update_{{entity}}(
        self, {{entity}}_id: uuid.UUID, payload: {{Entity}}Update
    ) -> {{Entity}}Read:
        """Apply a partial update to one {{entity}} inside a single transaction."""
        try:
            async with transaction(self._session):
                record = await self._{{entities}}.get_for_update({{entity}}_id)
                if record is None:
                    raise NotFoundException(NOT_FOUND_MESSAGE)
                await self._{{entities}}.update(
                    record,
{{service_update_kwargs}}
                )
        except IntegrityError:
            raise ConflictException(CONFLICT_MESSAGE) from None
        return to_{{entity}}_read(record)


__all__ = ["{{Entity}}Service", "to_{{entity}}_read"]
