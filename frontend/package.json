{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run generate:api",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:files": "eslint --no-warn-ignored",
    "format": "prettier --check .",
    "format:files": "prettier --check --ignore-unknown",
    "format:write": "prettier --write .",
    "pretypecheck": "npm run generate:api",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run generate:api",
    "test": "vitest run --coverage",
    "pretest:fast": "node scripts/ensure-generated.mjs",
    "test:fast": "vitest run",
    "test:watch": "vitest",
    "test:lint-rules": "node tools/eslint/no-imperative-event-handlers.test.cjs",
    "generate:api": "orval --config orval.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.5",
    "@tanstack/react-query": "5.107.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.3",
    "eslint-plugin-jsdoc": "65.4.5",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-use-client": "1.2.0",
    "jsdom": "31.0.0",
    "msw": "3.0.4",
    "orval": "8.47.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "@tailwindcss/oxide@4.1.11": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "msw@2.15.0": true
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "source-map-js": "1.2.2",
    "undici": "7.30.2",
    "vite": "6.4.6"
  }
}
